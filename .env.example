# ===================================================================
# Student Grade Management System - Environment Configuration Template
# Copy to .env for local overrides or configure in cloud dashboard
# ===================================================================

# Server Port (Cloud platforms like Render automatically provide $PORT)
PORT=8080

# -------------------------------------------------------------------
# Database Options
# -------------------------------------------------------------------

# Option A: Cloud Managed PostgreSQL (Auto-injected by Render/Heroku/Railway)
# DATABASE_URL=postgres://username:password@hostname:5432/database_name

# Option B: Standard JDBC PostgreSQL Connection
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/studentgradedb
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_secure_password

# Option C: Embedded Persistent H2 File Database (Default for local development)
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/studentgradedb;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# -------------------------------------------------------------------
# Security & Networking
# -------------------------------------------------------------------
# Optional: Comma-separated list of additional allowed CORS origins (for separate frontend domains)
# CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:3000

# -------------------------------------------------------------------
# Frontend Dev Configuration (Only needed when running Vite independently on port 3000)
# In production, leave empty to use relative '/api' on the same origin
# -------------------------------------------------------------------
VITE_API_BASE_URL=
